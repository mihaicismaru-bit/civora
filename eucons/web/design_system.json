{
  "schema_version": 1,
  "product": "EUCONS_COMMERCIAL_OS",
  "phase": "E07",
  "status": "CANONICAL",
  "principles": [
    "commercial_clarity_before_decoration",
    "institutional_trust_without_bureaucratic_visual_weight",
    "evidence_first_presentation",
    "mobile_first",
    "accessible_by_default",
    "provider_independent_assets",
    "no_external_font_runtime_dependency"
  ],
  "tokens": {
    "color": {
      "ink": "#101828",
      "ink_soft": "#344054",
      "muted": "#475467",
      "navy": "#0B1F33",
      "brand": "#1769E0",
      "brand_strong": "#124FAC",
      "success": "#067647",
      "warning": "#935000",
      "danger": "#B42318",
      "background": "#F6F8FB",
      "surface": "#FFFFFF",
      "surface_subtle": "#EEF2F6",
      "border": "#D0D5DD",
      "focus": "#1769E0"
    },
    "font": {
      "sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "body_min_px": 16,
      "body_line_height": 1.6,
      "measure_ch": 72
    },
    "space_px": [4, 8, 12, 16, 24, 32, 48, 64, 96],
    "radius_px": {"sm":8,"md":14,"lg":22,"pill":999},
    "shadow": {
      "card": "0 10px 30px rgba(16,24,40,.08)",
      "lift": "0 18px 48px rgba(16,24,40,.12)"
    },
    "layout": {
      "content_max_px": 1180,
      "reading_max_ch": 72,
      "gutter_mobile_px": 20,
      "gutter_desktop_px": 32,
      "header_min_px": 72
    },
    "interaction": {
      "min_touch_target_px": 44,
      "focus_ring_px": 3,
      "focus_offset_px": 3,
      "transition_ms": 160,
      "reduced_motion_supported": true
    }
  },
  "required_contrast_pairs": [
    {"foreground":"ink","background":"surface","minimum":4.5},
    {"foreground":"muted","background":"surface","minimum":4.5},
    {"foreground":"surface","background":"navy","minimum":4.5},
    {"foreground":"surface","background":"brand","minimum":4.5},
    {"foreground":"surface","background":"brand_strong","minimum":4.5},
    {"foreground":"surface","background":"success","minimum":4.5},
    {"foreground":"surface","background":"warning","minimum":4.5},
    {"foreground":"surface","background":"danger","minimum":4.5}
  ],
  "components": {
    "button": {
      "variants":["primary","secondary","quiet","danger"],
      "states":["default","hover","focus-visible","disabled","loading"],
      "minimum_height_px":44
    },
    "link": {
      "states":["default","hover","focus-visible","visited"],
      "underline_or_noncolor_cue_required":true
    },
    "card": {
      "variants":["service","opportunity","person","case","knowledge","metric"],
      "clickable_card_requires_single_primary_link":true
    },
    "form_control": {
      "types":["input","textarea","select","checkbox","radio"],
      "states":["default","focus-visible","invalid","disabled"],
      "visible_label_required":true,
      "error_message_id_required":true
    },
    "badge": {
      "variants":["neutral","info","success","warning","danger"],
      "color_only_meaning_forbidden":true
    },
    "alert": {
      "variants":["info","success","warning","danger"],
      "semantic_role_required":true
    },
    "header": {
      "desktop_navigation":true,
      "mobile_navigation":true,
      "skip_link_required":true
    },
    "footer": {
      "legal_links_required":true,
      "primary_cta_forbidden":false
    }
  },
  "content_presentation": {
    "unverified_claim_visualization":"OMIT",
    "hold_people_visualization":"OMIT",
    "hold_cases_visualization":"OMIT",
    "opportunity_maturity_label_required":true,
    "service_primary_cta_required":true,
    "evidence_source_area_supported":true,
    "numbers_without_claim_reference_forbidden":true
  },
  "responsive_breakpoints_px": {"sm":640,"md":768,"lg":1024,"xl":1280},
  "asset_policy": {
    "remote_font_urls_forbidden":true,
    "remote_css_urls_forbidden":true,
    "invented_real_person_portraits_forbidden":true,
    "logo_source_state":"PENDING_VERIFIED_ASSET",
    "logo_fallback":"EUROCONSULT_WORDMARK_TEXT"
  }
}

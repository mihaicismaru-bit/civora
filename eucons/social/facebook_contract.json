{
  "schema_version": 1,
  "engine_id": "EUCONS_E18_FACEBOOK_ADAPTER",
  "input": {
    "required_product": "EUCONS_COMMERCIAL_OS",
    "required_editorial_engine_id": "EUCONS_E15_AUTONOMOUS_EDITORIAL_LOOP",
    "required_knowledge_engine_id": "EUCONS_E14_KNOWLEDGE_ENGINE",
    "required_editorial_decision": "READY",
    "allowed_types": ["GUIDE", "ANALYSIS", "OPPORTUNITY", "CASE", "FAQ"]
  },
  "doctrine": {
    "purpose": "Accessible commercial education and opportunity discovery for Facebook audiences without weakening evidence rules.",
    "site_is_canonical": true,
    "linkedin_verbatim_reuse_forbidden": true,
    "unverified_claims_fail_closed": true
  },
  "presentation": {
    "canonical_base": "https://eucons.ro",
    "route_templates": {
      "GUIDE": "/ghiduri/{source_ref}/",
      "ANALYSIS": "/articole/{source_ref}/",
      "OPPORTUNITY": "/finantari/{source_ref}/",
      "CASE": "/proiecte/{source_ref}/",
      "FAQ": "/resurse/{source_ref}/"
    },
    "lead_in_by_type": {
      "GUIDE": "Pe scurt, ce trebuie să știi.",
      "ANALYSIS": "Cum privim practic situația.",
      "OPPORTUNITY": "O oportunitate de finanțare care merită verificată.",
      "CASE": "Din practică: un exemplu verificat.",
      "FAQ": "Întrebare frecventă, răspuns clar."
    },
    "cta_by_type": {
      "GUIDE": "Citește ghidul pe EUCONS:",
      "ANALYSIS": "Citește analiza pe EUCONS:",
      "OPPORTUNITY": "Vezi detaliile și cere o evaluare:",
      "CASE": "Vezi cazul complet:",
      "FAQ": "Vezi răspunsul complet:"
    },
    "max_body_chars": 2200,
    "hashtags_default": false
  },
  "dispatch": {
    "mode": "DRY_RUN_ONLY",
    "dry_run_state": "FACEBOOK_OUTBOX_READY_AUTH_REQUIRED",
    "real_publication_enabled": false,
    "external_authorization_required": ["FACEBOOK_PAGE", "META_APP"],
    "max_attempts": 3,
    "idempotent": true,
    "immutable_receipts": true
  },
  "output": {
    "schema_version": 1,
    "product": "EUCONS_COMMERCIAL_OS",
    "platform": "facebook",
    "direct_publication_enabled": false
  }
}

{
  "schema_version": 1,
  "id": "R06-CF-CONTRACT-001",
  "product": "EUCONS_COMMERCIAL_OS",
  "phase": "R06_PROSPECT_DISCOVERY_CLIENT_FINDER",
  "status": "CANONICAL",
  "checked_at": "2026-08-26T00:49:00+03:00",
  "purpose": "Define an organization-first, evidence-bound prospect record that turns lawful public signals into an auditable research queue without asserting eligibility, inferring sensitive traits, collecting private-person data, or contacting anyone autonomously.",
  "canonical_dependencies": {
    "customer_demand_model": "eucons/market_intelligence/EUCONS_CUSTOMER_DEMAND_MODEL_2026-08-25.json",
    "service_registry": "eucons/services/service_registry.json",
    "service_proof_architecture": "eucons/evidence/service_proof_architecture.json",
    "opportunity_bridge": "eucons/opportunities/bridge_contract.json",
    "opportunity_matching": "eucons/opportunities/matching_contract.json",
    "privacy_security": "eucons/security/privacy_security_contract.json"
  },
  "truth_model": {
    "classes": [
      "FACT",
      "INFERENCE",
      "UNKNOWN",
      "CONFLICT"
    ],
    "fact_rule": "Every FACT requires at least one source_ref. A material funding, eligibility, budget, deadline, indicator or obligation fact requires an OFFICIAL source.",
    "inference_rule": "Every INFERENCE requires one or more supporting FACT assertion IDs, a bounded confidence value and an explicit verification question. It may never state eligibility, award probability or purchase intent as fact.",
    "unknown_rule": "Missing qualification information remains UNKNOWN and becomes a verification question.",
    "conflict_rule": "Conflicting source statements remain CONFLICT; the affected field is held from scoring and action preparation until resolved.",
    "public_claim_rule": "Client Finder records are internal research objects. They do not become public claims or case-study evidence."
  },
  "organization_identity": {
    "required": [
      "legal_name",
      "country_code",
      "organization_type"
    ],
    "allowed": [
      "legal_name",
      "country_code",
      "organization_type",
      "public_registration_id",
      "official_domain",
      "region",
      "locality",
      "public_activity_codes",
      "official_profile_url"
    ],
    "organization_types": [
      "COMPANY",
      "PUBLIC_AUTHORITY",
      "PUBLIC_INSTITUTION",
      "NGO",
      "SOCIAL_ECONOMY",
      "TRAINING_PROVIDER",
      "RURAL_OPERATOR",
      "OTHER_ORGANIZATION"
    ],
    "deterministic_key": {
      "preferred": "SHA256(country_code + public_registration_id)",
      "fallback": "SHA256(country_code + normalized_legal_name + official_domain + region)",
      "ambiguous_result": "HOLD_IDENTITY_AMBIGUOUS",
      "rule": "Fallback is allowed only when official_domain and region are both present; fuzzy name-only merging is forbidden."
    }
  },
  "privacy_boundary": {
    "mode": "ORGANIZATION_FIRST",
    "allowed_public_business_surfaces": [
      "organization_official_website",
      "official_public_registry",
      "official_procurement_profile",
      "official_beneficiary_list",
      "role_based_business_contact_page"
    ],
    "person_level_fields_forbidden": [
      "person_name",
      "personal_email",
      "personal_phone",
      "home_address",
      "personal_social_profile",
      "personal_identifier",
      "date_of_birth",
      "private_contact"
    ],
    "sensitive_or_protected_inference_forbidden": [
      "health",
      "ethnicity",
      "religion",
      "political_opinion",
      "trade_union_membership",
      "sexual_orientation",
      "biometric_identity",
      "criminal_history",
      "household_or_family_status"
    ],
    "role_contact_rule": "R06 may retain only a URL to a public role-based business contact surface. Contact extraction and lawful-basis assessment belong to R08.",
    "visitor_deanonymization_forbidden": true,
    "private_database_enrichment_forbidden": true
  },
  "source_contract": {
    "required_fields": [
      "source_id",
      "source_type",
      "authority",
      "url",
      "title",
      "retrieved_at",
      "content_hash",
      "official",
      "public_access"
    ],
    "allowed_types": [
      "OFFICIAL_FUNDING_SOURCE",
      "OFFICIAL_PUBLIC_PROCUREMENT",
      "OFFICIAL_BENEFICIARY_OR_AWARD_LIST",
      "OFFICIAL_PUBLIC_STRATEGY_OR_PLAN",
      "OFFICIAL_PUBLIC_REGISTRY",
      "ORGANIZATION_OFFICIAL_SITE",
      "ORGANIZATION_OFFICIAL_ANNOUNCEMENT",
      "PUBLIC_NEWS_DISCOVERY",
      "PARTENER_DISCOVERY_READ_ONLY"
    ],
    "official_types": [
      "OFFICIAL_FUNDING_SOURCE",
      "OFFICIAL_PUBLIC_PROCUREMENT",
      "OFFICIAL_BENEFICIARY_OR_AWARD_LIST",
      "OFFICIAL_PUBLIC_STRATEGY_OR_PLAN",
      "OFFICIAL_PUBLIC_REGISTRY"
    ],
    "discovery_only_types": [
      "PUBLIC_NEWS_DISCOVERY",
      "PARTENER_DISCOVERY_READ_ONLY"
    ],
    "material_funding_authority_rule": "Discovery-only sources may locate a candidate, but material funding or eligibility facts require a linked OFFICIAL source before the signal is actionable.",
    "retrieval_rule": "Automated collection must respect public access controls, applicable terms, robots directives where relevant, rate limits and source-specific reuse constraints. Authentication bypass and private areas are forbidden.",
    "provenance_rule": "Store URL, authority, retrieval timestamp and content hash; preserve quoted snippets only when needed and within reuse constraints."
  },

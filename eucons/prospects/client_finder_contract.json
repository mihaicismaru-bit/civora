  "prospect_record": {
    "required": [
      "prospect_id",
      "organization",
      "sources",
      "assertions",
      "signals",
      "state",
      "created_at",
      "updated_at",
      "expires_at",
      "suppression"
    ],
    "states": [
      "DISCOVERED",
      "EVIDENCE_COMPLETE",
      "READY_FOR_SCORING",
      "HOLD_SOURCE_STATE",
      "HOLD_STALE",
      "HOLD_CONFLICT",
      "HOLD_IDENTITY_AMBIGUOUS",
      "SUPPRESSED"
    ],
    "signal_required_fields": [
      "signal_id",
      "signal_type",
      "source_refs",
      "observed_at",
      "expires_at",
      "fact_assertion_ids",
      "confidence",
      "why_now"
    ],
    "confidence_range": [
      0,
      1
    ],
    "expiry_rule": "Every active signal and prospect requires expires_at. A signal is inactive when now >= expires_at or a linked source is stale/held.",
    "suppression_rule": "SUPPRESSED records cannot be scored, prepared for outreach or reactivated without a documented review event.",
    "dedupe_rule": "One deterministic organization key; repeated source observations append provenance and refresh only after validation. Same source_id with a different content_hash is a new version, not silent overwrite.",
    "storage_rule": "No real prospect records are committed to the public repository. Synthetic fixtures must be labelled NON_EVIDENCE."
  },
  "qualification_gate": {
    "ready_for_scoring_requires": [
      "deterministic organization identity not ambiguous",
      "at least one unexpired signal",
      "all signal FACT assertions have source references",
      "material funding facts have an official source",
      "no unresolved conflict on organization identity or why-now basis",
      "at least one canonical job_id and service_id",
      "suppression state is clear"
    ],
    "score_semantics": "COMMERCIAL_RESEARCH_PRIORITY_NOT_ELIGIBILITY_OR_PURCHASE_INTENT",
    "eligibility_state": "NOT_ASSESSED",
    "next_phase": "R06-CF-ENGINE-001"
  },
  "external_action_gate": {

{
  "schema_version": 2,
  "engine_id": "EUCONS_E10_OPPORTUNITY_MATCHING",
  "score_semantics": "RELEVANCE_NOT_APPROVAL_PROBABILITY",
  "input": {
    "profile_id_required": true,
    "allowed_profile_fields": ["profile_id", "audience_id", "organization_labels", "activity_codes", "region_terms", "investment_terms", "requested_grant_eur"],
    "pii_fields_forbidden": ["name", "email", "phone", "address", "personal_identifier"],
    "list_fields": ["organization_labels", "activity_codes", "region_terms", "investment_terms"]
  },
  "source_guards": {
    "required_bridge_state": "READY",
    "required_record_state": "VERIFIED_AVAILABLE",
    "require_actionable": true,
    "stale_or_held_result": "HOLD_SOURCE_STATE"
  },
  "official_source_guards": {
    "partener_role": "DISCOVERY_ONLY",
    "registry_schema_version": 1,
    "registry_state": "READ_ONLY_OFFICIAL_SOURCE_RECEIPTS",
    "verified_state": "VERIFIED_OFFICIAL_SOURCE",
    "conflict_state": "BLOCKED_SOURCE_CONFLICT",
    "verification_method": "OFFICIAL_SOURCE_READBACK",
    "waiting_authority_state": "WAITING_SOURCE",
    "verified_authority_state": "OFFICIAL_SOURCE_VERIFIED",
    "blocked_authority_state": "BLOCKED_SOURCE_CONFLICT",
    "required_candidate_fact_classes": ["status", "deadline"],
    "material_fact_classes_requiring_official_binding": ["status", "deadline", "budget", "grant", "beneficiaries", "eligibility", "scoring", "indicators", "obligations"],
    "source_url_scheme": "https",
    "forbidden_source_products": ["PARTENER.EU"],
    "fact_binding": "SHA256_CANONICAL_JSON_EXACT_VALUE"
  },
  "hard_exclusions": {
    "activity_code_mismatch_when_official_eligibility_bound": true,
    "requested_grant_above_official_grant_cap": true,
    "result": "EXCLUDED_KNOWN_RULE"
  },
  "weights": {
    "activity_code": 35,
    "investment_terms_max": 30,
    "organization_terms_max": 20,
    "region_terms_max": 10,
    "grant_within_verified_cap": 5
  },
  "thresholds": {
    "match_candidate_min": 40,
    "high_confidence_min_score": 70,
    "high_confidence_min_positive_dimensions": 3,
    "medium_confidence_min_score": 40,
    "medium_confidence_min_positive_dimensions": 2
  },
  "outputs": {
    "candidate": "MATCH_CANDIDATE",
    "insufficient": "REQUIRES_DATA",
    "excluded": "EXCLUDED_KNOWN_RULE",
    "held": "HOLD_SOURCE_STATE",
    "confidence_levels": ["LOW", "MEDIUM", "HIGH"]
  },
  "rules": {
    "explanations_required": true,
    "hard_exclusion_reasons_required": true,
    "deterministic_sort": ["score_desc", "opportunity_id_asc"],
    "never_claim_eligibility_or_award_probability": true,
    "source_provenance_must_be_retained": true,
    "partener_material_facts_never_authoritative_without_official_binding": true,
    "official_source_conflict_fails_closed": true,
    "missing_official_source_fails_closed": true,
    "no_external_fetch_or_write": true
  }
}

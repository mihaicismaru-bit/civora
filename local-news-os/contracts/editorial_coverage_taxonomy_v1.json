    {"id":"consumer","label":"Consumatori, prețuri și servicii","source_classes":["CONSUMER_AUTHORITY","UTILITY_OPERATOR","RETAILER","MARKET_DATA"],"formats":["service","price_watch","explainer"]},
    {"id":"heritage_history","label":"Patrimoniu și istorie locală","source_classes":["MUSEUM","ARCHIVE","LIBRARY","CULTURAL_INSTITUTION"],"formats":["history","explainer","anniversary"]},
    {"id":"community_signals","label":"Comunitate și semnale locale","source_classes":["LOCAL_PRESS","COMMUNITY_PAGE","PUBLIC_GROUP","PUBLIC_COMMENT","CREATOR"],"formats":["signal"],"publication_authority":"NONE"}
  ]
}

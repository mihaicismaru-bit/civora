    {"id":"environment","label":"Mediu, apă, păduri și biodiversitate","source_classes":["WATER_AUTHORITY","ENVIRONMENT_AGENCY","ENVIRONMENT_GUARD","FORESTRY","PROTECTED_AREA"],"formats":["alert","straight_news","data_story","investigation"]},
    {"id":"weather_hazards","label":"Vreme și riscuri naturale","source_classes":["METEO_ALERT","HYDRO_ALERT","MOUNTAIN_RESCUE","EMERGENCY_ALERT"],"formats":["alert","service","breaking"]},
    {"id":"agriculture_rural","label":"Agricultură și economie rurală","source_classes":["AGRICULTURE_AGENCY","APIA","DSVSA","UAT","PRODUCER"],"formats":["service","straight_news","trend"]},
    {"id":"sport","label":"Sport județean și local","source_classes":["CLUB","FEDERATION","ASSOCIATION","SCHOOL_SPORT"],"formats":["results","preview","straight_news","profile"]},

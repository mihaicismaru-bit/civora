{
  "schema_version": "1.0",
  "product": "LOCAL NEWS OS Fleet Observed Metrics Credential Bindings",
  "policy": {
    "explicit_per_instance_grant_required": true,
    "transport_capability_binding_required": true,
    "cross_instance_secret_sharing_forbidden": true,
    "secret_values_in_registry_forbidden": true,
    "dynamic_secret_enumeration_forbidden": true,
    "analytics_advisory_only": true,
    "zero_paid_dependency": true
  },
  "bindings": [
    {
      "binding_id": "valcea-meta-observed-metrics-v1",
      "instance_id": "valcea",
      "credential_namespace": "VALCEA_",
      "capability_grants": [
        {
          "transport_capability_id": "meta-facebook-observed-metrics-v1",
          "metric_source": "meta_graph_api",
          "credential_env_name": "VALCEA_FB_PAGE_ACCESS_TOKEN"
        },
        {
          "transport_capability_id": "meta-instagram-observed-metrics-v1",
          "metric_source": "instagram_graph_api",
          "credential_env_name": "VALCEA_IG_ACCESS_TOKEN"
        }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-news-os.invalid/schemas/series_registry.schema.json",
  "title": "LOCAL NEWS OS Social SERIES_REGISTRY",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "channels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "instance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "channels": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "series_id", "priority", "slots", "preferred_formats", "eligible_topics",
            "min_interval_hours", "max_occurrences_7d", "replay_policy",
            "resurface_after_hours", "min_items", "max_items"
          ],
          "properties": {
            "series_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "priority": {"type": "integer", "minimum": 0, "maximum": 100},
            "slots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["days", "time", "window_minutes"],
                "properties": {
                  "days": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 6}},
                  "time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
                  "window_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}
                }
              }
            },
            "preferred_formats": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["text", "single_photo", "carousel", "story", "reel", "short", "long_video", "thread", "alert", "digest", "live"]}
            },
            "eligible_topics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "min_interval_hours": {"type": "integer", "minimum": 0, "maximum": 720},
            "max_occurrences_7d": {"type": "integer", "minimum": 1, "maximum": 100},
            "replay_policy": {"enum": ["new_story_only", "material_update", "evergreen_refresh"]},
            "resurface_after_hours": {"type": "integer", "minimum": 0, "maximum": 8760},
            "min_items": {"type": "integer", "minimum": 1, "maximum": 20},
            "max_items": {"type": "integer", "minimum": 1, "maximum": 20}
          }
        }
      }
    }
  }
}

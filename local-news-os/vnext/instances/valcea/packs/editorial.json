{
  "schema_version": "2.0",
  "pack_type": "editorial",
  "instance_id": "valcea",
  "auto_publish_classes": [
    "straight_news",
    "service_news",
    "verified_administrative_decision",
    "verified_jobs",
    "verified_event_program"
  ],
  "human_review_classes": [
    "reputational_claim",
    "investigation",
    "legal_ambiguity"
  ],
  "rules": {
    "verified_facts_only": true,
    "title_only_publishable": false,
    "one_held_story_blocks_publication": false
  },
  "newsworthiness": {
    "weights": {
      "local_impact": 20,
      "public_utility": 16,
      "urgency": 14,
      "money": 12,
      "affected_people": 12,
      "novelty": 10,
      "accountability": 10,
      "proximity": 6
    },
    "routing_thresholds": {
      "BUILD_PRIORITY": 80,
      "BUILD": 55,
      "MONITOR": 30
    }
  },
  "story_engine": {
    "default_section": "ACTUALITATE",
    "max_headline_chars": 120,
    "max_dek_chars": 220,
    "section_by_claim_kind": {
      "MONEY": "ECONOMIE",
      "PERCENT": "ADMINISTRAȚIE",
      "DATE": "ACTUALITATE",
      "NUMBER": "ACTUALITATE",
      "HEADLINE_ASSERTION": "ACTUALITATE"
    },
    "follow_up_label": "Ce urmărim"
  },
  "editorial_qa": {
    "default_editorial_class": "straight_news",
    "minimum_body_blocks": 2,
    "minimum_primary_sources": 1,
    "duplicate_headline_similarity_threshold": 0.92,
    "max_source_future_skew_hours": 6,
    "risk_term_classes": [
      {
        "editorial_class": "reputational_claim",
        "terms": ["acuz", "suspect", "fraud", "corup", "mită", "mita", "abuz", "infracți", "infracti"]
      },
      {
        "editorial_class": "investigation",
        "terms": ["anchet", "perchezi", "dna", "diicot"]
      },
      {
        "editorial_class": "legal_ambiguity",
        "terms": ["litig", "proces", "instanț", "instanta", "dosar civil", "dosar penal"]
      }
    ]
  }
}

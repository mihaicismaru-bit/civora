  "transport_twin_contract": {
    "synthetic_credentials_only": true,
    "test_marker_required": "PPOS_TEST_ONLY",
    "synthetic_destination_only": true,
    "synthetic_api_version_only": true,
    "nonroutable_image_staging_only": true,
    "exact_cp50_plan_binding_required": true,

{
  "schema_version": "PPOS_META_TRANSPORT_TEST_TWIN_POLICY_V1",
  "checkpoint": "CP54",
  "module_id": "M23_META_TRANSPORT_TWIN",
  "active_platforms": [
    "FACEBOOK_PAGE",
    "INSTAGRAM_PROFESSIONAL",
    "THREADS"

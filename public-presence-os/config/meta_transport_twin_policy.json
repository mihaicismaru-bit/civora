    "account_connection_allowed": false,
    "network_allowed": false,
    "publish_execution_allowed": false,
    "external_write_allowed": false,
    "deploy_allowed": false
  },
  "safety": {
    "global_kill_switch_required": true,
    "global_kill_switch_must_remain_engaged": true,
    "live_reverification_required": true,
    "test_credentials_must_never_be_accepted_by_live_transport": true,
    "no_publication": true,
    "no_real_accounts": true,
    "no_paid_services": true
  },
  "excluded_platforms": {

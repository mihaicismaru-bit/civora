{
  "schema_version": 9,
  "product": "CIVORA / VÂLCEA CLAR",
  "canonical_domain": "valceaclar.ro",
  "execution_owner": "civora_site_engine",
  "scheduler": "github_actions",
  "state_owner": "repository",
  "publication_model": "continuous_story_first",
  "publication_rule": "publish_each_story_as_soon_as_it_passes_editorial_and_quality_gates; editions_are_recaps_not_gates",
  "chatgpt": {
    "scheduled_tasks_allowed": false,
    "conversation_runtime_allowed": false,
    "direct_social_publication_allowed": false,
    "social_credential_access_allowed": false,
    "role": "operator_console_only",
    "presentation_bridge_may_exist": true,
    "presentation_bridge_is_not_scheduler": true
  },
  "content_engine": {
    "generator": "deterministic_zero_llm_v2",
    "fact_kernel_builder": "fact_kernel_orchestrator_v2",
    "fact_kernel_registry": "valcea-clar/editorial/fact_kernel_registry.json",
    "fact_kernel_promotion": "verified_only_claim_level_provenance",
    "facts_registry_single_writer": ".github/workflows/valcea-clar-fact-kernel.yml",
    "structured_alert_event_source": "valcea-clar/editorial/structured_alert_events.json",
    "partial_document_coverage_publishable": false,
    "editorial_writer": "manual_journalism_v1",
    "editorial_manual": "valcea-clar/editorial/editorial_manual.json",
    "editorial_writer_runtime": "valcea-clar/scripts/editorial_writer.py",
    "editorial_writer_activation_point": "valcea-clar/scripts/generate_edition.py:merged_registry",
    "editorial_integrity_gate": "editorial_integrity_v1",
    "editorial_integrity_runtime": "valcea-clar/scripts/editorial_integrity.py",
    "editorial_integrity_activation_point": "valcea-clar/scripts/newsroom_decide.py:story_ready",
    "post_writer_product_fingerprint_required": true,
    "paragraph_to_claim_hash_identity_required": true,
    "new_story_fact_kernel_target": true,
    "claim_level_provenance_required_for_new_kernel_composition": true,
    "legacy_verified_copy_rewritten": false,
    "reputational_formats_fail_closed": true,
    "paid_llm_api_required": false,
    "local_agent_runtime_required": false,
    "self_hosted_runner_allowed": false,
    "story_first": true,
    "edition_window_may_delay_publishable_story": false,
    "title_date_only_candidate_is_article": false,
    "fail_closed_on_incomplete_story": true,
    "site_and_social_share_story_identity": true
  },
  "jobs": [
    {
      "id": "live_newsroom",
      "kind": "continuous_story_discovery_validation_and_publication",
      "workflow": ".github/workflows/valcea-clar-newsroom-live.yml",
      "schedule": ["*/5 * * * *"],
      "schedule_role": "polling_fallback_only",
      "event_triggers": true,
      "publication_gate": "post_writer_integrity_and_per_story_quality_gate",
      "edition_window_gate": false,
      "editorial_writer": "manual_journalism_v1",
      "editorial_integrity_gate": "editorial_integrity_v1",
      "emits": "valcea-clar/site/story_publication_event.json",
      "post_persist_dispatch": ".github/workflows/valcea-clar-social-publishing.yml",
      "post_persist_dispatch_mode": "explicit_workflow_dispatch",
      "owner": "site_engine"
    },
    {
      "id": "fact_kernel_builder",
      "kind": "single_writer_verified_fact_materialization",
      "workflow": ".github/workflows/valcea-clar-fact-kernel.yml",
      "schedule": ["4,19,34,49 * * * *"],
      "schedule_role": "bounded_polling_fallback",
      "event_triggers": ["structured_alert_events", "manual_publish_queue", "supplemental_facts", "kernel_code_or_policy_change"],
      "adapters": ["council", "adopted_hcl_articles", "structured_t1_alerts", "primary_source_service", "primary_source_admin", "manual_intake", "supplemental_dossiers", "gambling_dossier", "scm_program"],
      "promotion_target": "valcea-clar/editorial/facts_registry.json",
      "promotion_rule": "verified_source_specific_contracts_only",
      "single_writer": true,
      "post_success_consumer": ".github/workflows/valcea-clar-newsroom-live.yml",
      "owner": "site_engine"
    },
    {
      "id": "editorial_writer_acceptance",
      "kind": "editorial_manual_fact_kernel_and_post_writer_integrity_validation",
      "workflow": ".github/workflows/valcea-clar-editorial-writer.yml",
      "schedule": [],
      "event_driven": true,
      "writer": "manual_journalism_v1",
      "integrity_gate": "editorial_integrity_v1",
      "owner": "site_engine"
    },
    {
      "id": "autonomous_editions",
      "kind": "morning_evening_recap_generation",
      "workflow": ".github/workflows/valcea-clar-editions.yml",
      "schedule": ["45,55 4,5,6 * * *", "30,40 15,16,17 * * *"],
      "timezone_gate": "Europe/Bucharest targets 07:45 and 18:30 for recap snapshots only; these windows never delay or authorize an individual story publication.",
      "publication_gate": false,
      "owner": "site_engine"
    },
    {
      "id": "source_radar",
      "kind": "canonical_source_health_signal_verification_and_discovery_control_plane",
      "workflow": ".github/workflows/valcea-clar-source-radar.yml",
      "schedule": ["*/10 * * * *", "23 * * * *", "47 */6 * * *"],
      "cadences": {
        "signal_radar_and_primary_verification": "*/10 * * * *",
        "bounded_discovery": "23 * * * *",
        "source_health": "47 */6 * * *"
      },
      "primary_verification_output": "valcea-clar/editorial/signal_primary_verification_state.json",
      "resolution_task_directory": "valcea-clar/ops/resolution_tasks",
      "owner": "site_engine"
    },
    {
      "id": "structured_primary_alerts",
      "kind": "rapid_t1_structured_event_ingest",
      "workflow": ".github/workflows/valcea-clar-structured-alerts.yml",
      "schedule": ["2-57/5 * * * *"],
      "writes": "valcea-clar/editorial/structured_alert_events.json",
      "facts_registry_write_allowed": false,
      "downstream_fact_writer": ".github/workflows/valcea-clar-fact-kernel.yml",
      "owner": "site_engine"
    },
    {
      "id": "editorial_opportunity_queue",
      "kind": "event_driven_ranked_editorial_candidate_queue",
      "workflow": ".github/workflows/valcea-clar-editorial-opportunity-engine.yml",
      "schedule": [],
      "event_driven": true,
      "publication_authority": "none",
      "owner": "site_engine"
    },
    {
      "id": "cultural_sources",
      "kind": "festival_and_performing_arts_source_monitoring",
      "workflow": ".github/workflows/valcea-clar-festival-intelligence-monitor.yml",
      "schedule": ["13 */2 * * *", "29 */6 * * *"],
      "cadences": {
        "performing_arts": "13 */2 * * *",
        "festival": "29 */6 * * *"
      },
      "publication_authority": "candidate_only",
      "owner": "site_engine"
    },
    {
      "id": "identity_intelligence",
      "kind": "people_and_artist_public_identity_projection",
      "workflow": ".github/workflows/valcea-clar-people-intelligence.yml",
      "schedule": ["29 */6 * * *"],
      "shared_indexing_transaction": true,
      "public_projection_requires_resolved_identity": true,
      "owner": "site_engine"
    },
    {
      "id": "person_candidate_discovery",
      "kind": "event_driven_unresolved_public_person_candidate_queue",
      "workflow": ".github/workflows/valcea-clar-person-candidate-discovery.yml",
      "schedule": [],
      "event_driven": true,
      "publication_authority": "none",
      "auto_profile_creation": false,
      "owner": "site_engine"
    },
    {
      "id": "photo_candidate_discovery",
      "kind": "event_driven_rights_candidate_discovery",
      "workflow": ".github/workflows/valcea-clar-photo-candidate-discovery.yml",
      "schedule": [],
      "event_driven": true,
      "publication_authority": "none",
      "automatic_promotion": false,
      "owner": "site_engine"
    },
    {
      "id": "monitor_ledger",
      "kind": "infrastructure_market_and_council_watch_state",
      "workflow": ".github/workflows/valcea-clar-monitor-ledger.yml",
      "schedule": ["11 * * * *"],
      "publication_authority": "none",
      "owner": "site_engine"
    },
    {
      "id": "observed_metrics",
      "kind": "social_observed_metrics_harvest",
      "workflow": ".github/workflows/valcea-clar-observed-metrics-harvest.yml",
      "schedule": ["23 * * * *"],
      "publication_blocking_allowed": false,
      "owner": "site_engine"
    },
    {
      "id": "venue_ingest",
      "kind": "venue_monitoring_and_ingest",
      "workflow": ".github/workflows/valcea-clar-venues-ingest.yml",
      "schedule": ["23 */6 * * *"],
      "owner": "site_engine"
    },
    {
      "id": "olanesti_investigation",
      "kind": "investigation_monitoring",
      "workflow": ".github/workflows/valcea-clar-olanesti-investigation-monitor.yml",
      "schedule": ["17 4,14 * * *"],
      "editorial_priority": "normal_case_priority; benchmark_only_for_investigation_engine",
      "owner": "site_engine"
    },
    {
      "id": "social_distribution",
      "kind": "multi_channel_social_distribution",
      "workflow": ".github/workflows/valcea-clar-social-publishing.yml",
      "schedule": ["7,22,37,52 * * * *"],
      "schedule_role": "recovery_only",
      "event_trigger": "valcea-clar/site/story_publication_event.json",
      "event_trigger_mode": "explicit_workflow_dispatch_after_canonical_story_persist",
      "distribution_unit": "individual_story",
      "edition_window_gate": false,
      "site_story_may_precede_social_media_readiness": true,
      "channel_registry": "valcea-clar/social/channel_registry.json",
      "owner": "site_engine"
    },
    {
      "id": "story_social_metadata_projection",
      "kind": "event_driven_story_open_graph_and_social_metadata_projection",
      "workflow": ".github/workflows/valcea-clar-story-social-metadata.yml",
      "schedule": [],
      "event_driven": true,
      "derived_only": true,
      "facts_registry_write_allowed": false,
      "owner": "site_engine"
    },
    {
      "id": "threads_direct_adapter",
      "kind": "event_driven_direct_threads_publication",
      "workflow": ".github/workflows/valcea-clar-threads-editorial.yml",
      "schedule": [],
      "event_driven": true,
      "event_trigger": "valcea-clar/site/story_publication_event.json",
      "max_per_run": 1,
      "activation_baseline_required": true,
      "owner": "site_engine"
    },
    {
      "id": "public_http_health",
      "kind": "read_only_public_http_observer",
      "workflow": ".github/workflows/valcea-clar-public-health.yml",
      "schedule": ["17,47 * * * *"],
      "repository_state_write_allowed": false,
      "owner": "site_engine"
    },
    {
      "id": "quality_gate",
      "kind": "event_driven_quality_assurance",
      "workflow": ".github/workflows/valcea-clar-quality.yml",
      "schedule": [],
      "owner": "site_engine"
    },
    {
      "id": "ownership_guard",
      "kind": "runtime_ownership_monitoring",
      "workflow": ".github/workflows/valcea-clar-engine-guard.yml",
      "schedule": ["11 2 * * *"],
      "owner": "site_engine"
    }
  ],
  "retired_external_monitors": [
    {
      "id": "VC-INV-2026-001",
      "scope": "Olănești–Omniasig investigation monitoring",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-olanesti-investigation-monitor.yml"
    },
    {
      "id": "LEGACY-CHATGPT-VALCEA-CLAR-*",
      "scope": "all recurring CIVORA/VÂLCEA CLAR monitoring and content-generation tasks outside the site engine",
      "status": "retired",
      "replacement": "registered GitHub Actions workflows in this file"
    },
    {
      "id": "LEGACY-CHATGPT-SOCIAL-PUBLISHING-*",
      "scope": "all recurring or direct social-network publishing initiated from ChatGPT",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-social-publishing.yml"
    }
  ],
  "retired_workflows": [
    {
      "path": ".github/workflows/valcea-clar-facebook.yml",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-social-publishing.yml"
    }
  ]
}

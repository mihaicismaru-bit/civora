{
  "schema_version": 3,
  "product": "CIVORA / VÂLCEA CLAR",
  "canonical_domain": "valceaclar.ro",
  "execution_owner": "civora_site_engine",
  "scheduler": "github_actions",
  "state_owner": "repository",
  "publication_model": "continuous_story_first",
  "publication_rule": "publish_each_story_as_soon_as_it_passes_editorial_and_quality_gates; editions_are_recaps_not_gates",
  "chatgpt": {
    "scheduled_tasks_allowed": false,
    "conversation_runtime_allowed": false,
    "direct_social_publication_allowed": false,
    "social_credential_access_allowed": false,
    "role": "operator_console_only",
    "presentation_bridge_may_exist": true,
    "presentation_bridge_is_not_scheduler": true
  },
  "content_engine": {
    "generator": "deterministic_zero_llm_v2",
    "paid_llm_api_required": false,
    "local_agent_runtime_required": false,
    "self_hosted_runner_allowed": false,
    "story_first": true,
    "edition_window_may_delay_publishable_story": false,
    "title_date_only_candidate_is_article": false,
    "fail_closed_on_incomplete_story": true,
    "site_and_social_share_story_identity": true
  },
  "jobs": [
    {
      "id": "live_newsroom",
      "kind": "continuous_story_discovery_validation_and_publication",
      "workflow": ".github/workflows/valcea-clar-newsroom-live.yml",
      "schedule": ["*/5 * * * *"],
      "schedule_role": "polling_fallback_only",
      "event_triggers": true,
      "publication_gate": "per_story_editorial_quality_gate",
      "edition_window_gate": false,
      "emits": "valcea-clar/site/story_publication_event.json",
      "owner": "site_engine"
    },
    {
      "id": "autonomous_editions",
      "kind": "morning_evening_recap_generation",
      "workflow": ".github/workflows/valcea-clar-editions.yml",
      "schedule": ["45,55 4,5,6 * * *", "30,40 15,16,17 * * *"],
      "timezone_gate": "Europe/Bucharest targets 07:45 and 18:30 for recap snapshots only; these windows never delay or authorize an individual story publication.",
      "publication_gate": false,
      "owner": "site_engine"
    },
    {
      "id": "source_radar",
      "kind": "source_monitoring",
      "workflow": ".github/workflows/valcea-clar-source-radar.yml",
      "schedule": ["47 */6 * * *"],
      "owner": "site_engine"
    },
    {
      "id": "venue_ingest",
      "kind": "venue_monitoring_and_ingest",
      "workflow": ".github/workflows/valcea-clar-venues-ingest.yml",
      "schedule": ["23 */6 * * *"],
      "owner": "site_engine"
    },
    {
      "id": "olanesti_investigation",
      "kind": "investigation_monitoring",
      "workflow": ".github/workflows/valcea-clar-olanesti-investigation-monitor.yml",
      "schedule": ["17 4,14 * * *"],
      "editorial_priority": "normal_case_priority; benchmark_only_for_investigation_engine",
      "owner": "site_engine"
    },
    {
      "id": "social_distribution",
      "kind": "multi_channel_social_distribution",
      "workflow": ".github/workflows/valcea-clar-social-publishing.yml",
      "schedule": ["7,22,37,52 * * * *"],
      "schedule_role": "recovery_only",
      "event_trigger": "valcea-clar/site/story_publication_event.json",
      "distribution_unit": "individual_story",
      "edition_window_gate": false,
      "site_story_may_precede_social_media_readiness": true,
      "channel_registry": "valcea-clar/social/channel_registry.json",
      "owner": "site_engine"
    },
    {
      "id": "quality_gate",
      "kind": "event_driven_quality_assurance",
      "workflow": ".github/workflows/valcea-clar-quality.yml",
      "schedule": [],
      "owner": "site_engine"
    },
    {
      "id": "ownership_guard",
      "kind": "runtime_ownership_monitoring",
      "workflow": ".github/workflows/valcea-clar-engine-guard.yml",
      "schedule": ["11 2 * * *"],
      "owner": "site_engine"
    }
  ],
  "retired_external_monitors": [
    {
      "id": "VC-INV-2026-001",
      "scope": "Olănești–Omniasig investigation monitoring",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-olanesti-investigation-monitor.yml"
    },
    {
      "id": "LEGACY-CHATGPT-VALCEA-CLAR-*",
      "scope": "all recurring CIVORA/VÂLCEA CLAR monitoring and content-generation tasks outside the site engine",
      "status": "retired",
      "replacement": "registered GitHub Actions workflows in this file"
    },
    {
      "id": "LEGACY-CHATGPT-SOCIAL-PUBLISHING-*",
      "scope": "all recurring or direct social-network publishing initiated from ChatGPT",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-social-publishing.yml"
    }
  ],
  "retired_workflows": [
    {
      "path": ".github/workflows/valcea-clar-facebook.yml",
      "status": "retired",
      "replacement_workflow": ".github/workflows/valcea-clar-social-publishing.yml"
    }
  ]
}

  },
  "platforms": {
    "x": {
      "channel_id": "valcea-x",
      "identity_mode": "profile_plus_editorial_voice",
      "product_role": "local_newswire",
      "presentation": {
        "text_first": true,
        "brand_prefix_each_post": false,
        "hashtags_default": false,
        "emoji_as_brand_device": false,
        "source_link_required_when_article_exists": true,
        "correction_label_explicit": true
      },
      "optional_visual": {
        "canvas": [1200, 675],
        "use_when": ["document_extract", "map", "data", "real_scene_photo"],
        "brand_treatment": "quiet_footer_or_corner_mark",
        "headline_overlay_default": false
      },
      "benchmark_character": "Reuters_AP_speed_and_source_discipline"
    },
    "threads": {
      "channel_id": "valcea-threads",
      "identity_mode": "profile_plus_conversational_editorial_voice",
      "product_role": "timely_local_context",
      "presentation": {
        "text_first": true,
        "brand_prefix_each_post": false,
        "hashtags_default": false,
        "generic_engagement_prompt_forbidden": true,
        "media_only_when_it_adds_evidence": true
      }
    },
    "linkedin": {
      "channel_id": "valcea-linkedin",
      "identity_mode": "profile_plus_evidence_led_professional_product",

  "quality_gate": {
    "all_secondary_channels_must_match_profile_channel_ids": true,
    "all_secondary_channels_must_match_doctrine_channel_ids": true,
    "all_products_must_declare_identity_lineage": true,
    "video_products_must_declare_on_screen_branding": true,
    "x_must_remain_text_first": true,
    "linkedin_must_remain_professional_evidence_led": true,
    "message_channels_must_not_become_visual_template_feeds": true

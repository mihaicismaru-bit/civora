        "text_first": true,
        "brand_prefix_each_message": false,
        "fake_urgency_forbidden": true,
        "media_only_when_evidence_or_utility_improves": true,
        "source_link_required_when_article_exists": true
      }
    },
    "whatsapp": {
      "channel_id": "valcea-whatsapp",
      "identity_mode": "profile_plus_low_frequency_trust_voice",
      "product_role": "essential_local_update",
      "presentation": {
        "low_frequency": true,
        "text_first": true,
        "brand_prefix_each_message": false,
        "recipient_scope_required_before_dispatch": true,
        "fake_urgency_forbidden": true,
        "source_link_required_when_article_exists": true

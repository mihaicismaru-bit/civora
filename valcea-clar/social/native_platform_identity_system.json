      "visual": {
        "portrait_card_canvas": [1200, 1500],
        "landscape_card_canvas": [1200, 627],
        "brand_treatment": "quiet_masthead_and_red_rule",
        "typography": "serif_masthead_sans_information",
        "photo_collage_forbidden": true,
        "marketing_badge_forbidden": true
      }
    },
    "tiktok": {
      "channel_id": "valcea-tiktok",
      "identity_mode": "on_screen_newsroom_identity",
      "product_role": "short_vertical_explainer",
      "visual": {
        "master_canvas": [1080, 1920],
        "brand_mark": "VC.",
        "brand_mark_position": "top_left_safe_area",
        "hook_target_words_max": 8,
        "subtitle_lines_max": 2,
        "subtitle_style": "high_contrast_no_full_width_marketing_banner",
        "source_end_slate": "VÂLCEA CLAR · valceaclar.ro",
        "synthetic_filler_forbidden": true,
        "archive_as_current_forbidden": true,
        "real_story_specific_media_required": true
      },
      "audio": {
        "voice_first": true,
        "music_dependency_required": false,
        "news_comprehension_without_sound_required": true
      }
    },
    "youtube": {
      "channel_id": "valcea-youtube",
      "identity_mode": "thumbnail_plus_video_newsroom_identity",
      "product_role": "durable_video_explainer",
      "thumbnail": {
        "canvas": [1280, 720],
        "brand_mark": "VC.",
        "brand_mark_position": "top_left",
        "text_words_target_max": 5,
        "headline_duplication_default": false,
        "one_dominant_visual_idea": true,
        "clickbait_visual_expression_forbidden": true,
        "marketing_badges_forbidden": true
      },
      "video": {
        "source_end_slate": "VÂLCEA CLAR · valceaclar.ro",
        "real_video_or_sufficient_visual_sequence_required": true,
        "synthetic_filler_forbidden": true,
        "archive_as_current_forbidden": true
      }

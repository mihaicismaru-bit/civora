{
  "schema_version": "1.1",
  "instance_id": "valcea",
  "policy": {
    "fail_closed_on_capability_mismatch": true,
    "durable_outbox_on_supported_channel_format_gap": true,
    "credential_values_allowed": false,
    "verbatim_cross_platform_reuse_allowed": false,
    "zero_paid_dependency": true
  },
  "adapters": [
    {
      "platform": "facebook",
      "channel_id": "valcea-facebook",
      "adapter": "valcea-clar/social/facebook_editorial_publish.py",
      "supported_native_formats": ["single_photo"],
      "supported_media_kinds": ["photo"],
      "max_media_assets": 1,
      "completion_model": "immediate_remote_id",
      "remote_reconciliation_supported": false
    },
    {
      "platform": "instagram",
      "channel_id": "valcea-instagram",
      "adapter": "valcea-clar/social/instagram_editorial_publish.py",
      "supported_native_formats": ["single_photo", "carousel"],
      "supported_media_kinds": ["photo"],
      "max_media_assets": 10,
      "completion_model": "immediate_remote_id",
      "remote_reconciliation_supported": false
    },
    {
      "platform": "threads",
      "channel_id": "valcea-threads",
      "adapter": "valcea-clar/social/threads_publish.py",
      "supported_native_formats": ["text", "thread"],
      "supported_media_kinds": [],
      "max_media_assets": 0,
      "completion_model": "immediate_remote_id_sequence",
      "remote_reconciliation_supported": false,
      "partial_publish_policy": "manual_reconciliation_no_auto_retry"
    },
    {
      "platform": "tiktok",
      "channel_id": "valcea-tiktok",
      "adapter": "valcea-clar/social/tiktok_publish.py",
      "supported_native_formats": ["single_photo", "short"],
      "supported_media_kinds": ["photo", "video"],
      "max_media_assets": 1,
      "completion_model": "async_remote_status",
      "remote_reconciliation_supported": true
    }
  ]
}

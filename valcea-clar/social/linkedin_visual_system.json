{
  "schema_version": "1.0",
  "channel_id": "valcea-linkedin",
  "master_identity_system": "valcea-clar/social/social_brand_system.json",
  "profile_identity_system": "valcea-clar/social/profile_identity_system.json",
  "role": "professional_public_money_economy_and_institutional_context",
  "canvas": {
    "portrait_card": {
      "width": 1200,
      "height": 1500,
      "aspect_ratio": "4:5"
    },
    "square_card": {
      "width": 1200,
      "height": 1200,
      "aspect_ratio": "1:1"
    },
    "document_page": {
      "width": 1080,
      "height": 1350,
      "aspect_ratio": "4:5"
    }
  },
  "brand": {
    "name": "VÂLCEA CLAR",
    "editorial_lockup": "VÂLCEA. CLAR.",
    "accent_rgb": [196, 27, 35],
    "paper_rgb": [247, 246, 243],
    "ink_rgb": [20, 20, 20],
    "white_rgb": [255, 255, 255],
    "logo_presence": "quiet_consistent",
    "design_tone": "newsroom_analysis_not_corporate_marketing"
  },
  "typography": {
    "headline_max_lines": 3,
    "headline_word_target_max": 12,
    "number_or_metric_may_be_primary": true,
    "source_label_required_on_data_or_document_cards": true,
    "principle": "professional_editorial_hierarchy_without_consulting_deck_clutter"
  },
  "templates": {
    "public_money_card": {
      "lead": "amount_plus_decision_or_contract",
      "support": "who_what_local_consequence",
      "footer": "source_and_date"
    },
    "data_card": {
      "lead": "one_metric_and_meaning",
      "support": "comparison_or_context",
      "footer": "source_and_period"
    },
    "document_explainer": {
      "cover": "one_question_or_consequence",
      "body": "one_documented_fact_per_page",
      "last": "what_is_known_unknown_and_source"
    },
    "local_economy_analysis": {
      "lead": "verified_change_or_signal",
      "support": "why_it_matters_for_local_organizations",
      "footer": "source"
    },
    "single_photo_context": {
      "lead": "local_consequence",
      "support": "professional_relevance",
      "footer": "canonical_story_when_needed"
    }
  },
  "copy": {
    "opening_rule": "lead_with_decision_number_or_professional_consequence",
    "jargon_rule": "translate_institutional_language_into_plain_romanian",
    "cta_rule": "no_generic_comment_or_share_prompt",
    "link_rule": "canonical_story_link_when_it_adds_detail_or_sources"
  },
  "qa": {
    "source_label_required_for_numbers": true,
    "real_story_specific_media_preferred": true,
    "synthetic_real_person_or_place_portrayal_forbidden": true,
    "generic_stock_substitution_forbidden": true,
    "fake_urgency_forbidden": true,
    "engagement_bait_forbidden": true,
    "verbatim_cross_posting_forbidden": true,
    "must_not_look_like_corporate_marketing": true,
    "must_not_look_like_local_marketing_page": true,
    "must_not_look_ai_generated": true,
    "must_not_repeat_identical_layout_for_every_story": true
  }
}

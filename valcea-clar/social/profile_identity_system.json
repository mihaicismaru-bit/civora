    "mark": "VC.",
    "circle_crop_safe_ratio": 0.72,
    "background": "paper",
    "foreground": "ink",
    "accent": "red_period",
    "requirements": [
      "legible_at_32px",
      "no_tagline",
      "no_photo",
      "same_master_mark_everywhere",
      "works_on_light_and_dark_ui"
    ]
  },
  "masthead": {

{
  "schema_version": "1.0",
  "product": "VÂLCEA CLAR Profile Identity System",
  "instance_id": "valcea",
  "brand_source": "valcea-clar/social/social_brand_system.json",
  "purpose": "one coherent premium newsroom identity across all public social profiles",
  "last_spec_review": "2026-08-16",
  "identity_principles": [
    "one_master_avatar_across_platforms",
    "masthead_not_marketing_banner",
    "limited_text_in_headers",
    "center_critical_information_for_responsive_crops",
    "high_contrast_mobile_legibility",
    "no_stock_city_collage",
    "no_platform_logo_inside_brand_assets",
    "no_gradient_heavy_social_aesthetic",
    "no_ai_generated_brand_texture",
    "same_newsroom_different_platform_product"
  ],
  "handle_policy": {
    "preferred": "valceaclar",
    "fallbacks": [
      "valcea.clar",
      "valceaclar.ro"
    ],
    "rule": "use_the_shortest_available_handle_that_preserves_the_brand"
  },
  "avatar": {

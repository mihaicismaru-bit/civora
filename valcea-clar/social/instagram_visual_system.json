{
  "schema_version": "1.1",
  "channel_id": "valcea-instagram",
  "master_identity_system": "valcea-clar/social/social_brand_system.json",
  "profile_identity_system": "valcea-clar/social/profile_identity_system.json",
  "feed_renderer": "valcea-clar/social/feed_identity_v1_1.py",
  "canvas": {"width": 1080, "height": 1350, "aspect_ratio": "4:5"},
  "brand": {
    "name": "VÂLCEA CLAR",
    "editorial_lockup": "VÂLCEA. CLAR.",
    "accent_rgb": [196, 27, 35],
    "paper_rgb": [247, 246, 243],
    "ink_rgb": [20, 20, 20],
    "white_rgb": [255, 255, 255],
    "safe_margin_px": 72,
    "top_margin_px": 64,
    "bottom_margin_px": 72,
    "logo_presence": "quiet_consistent"
  },
  "profile_identity": {
    "avatar_strategy": "small_size_editorial_mark_from_master_lockup",
    "avatar_legible_at_px": 32,
    "header_or_profile_art_direction": "publisher_masthead_not_marketing_banner",
    "bio_strategy": "mission_first_plus_coverage_plus_canonical_site",
    "grid_rule": "recognizable_as_one_newsroom_without_repeating_one_template"
  },
  "feed_visual_signature": {
    "composition": "image_dominant_full_bleed_editorial_cover",
    "brand_mark": "VC.",
    "brand_mark_period": "typographic_red_same_baseline",
    "brand_mark_role": "quiet_newsroom_locator",
    "section_label": "plain_uppercase_no_pill",
    "headline_family": "serif_bold",
    "supporting_family": "sans",
    "accent_rule": "single_short_red_locator_near_headline",
    "readability_gradient": "allowed_only_to_protect_text_over_real_photo",
    "decorative_gradient": false,
    "decorative_badges": false,
    "drop_shadows": false,
    "debug_or_status_metadata_in_artwork": false,
    "primary_subject_protection": true,
    "text_slide_grid": "VC_mark_hairline_kicker_large_lead_body_split_footer",
    "negative_space_on_text_slides": "deliberate"
  },
  "typography": {
    "headline_max_lines": 3,
    "headline_size_max": 78,
    "headline_size_min": 60,
    "subline_size": 34,
    "kicker_size": 25,
    "brand_size": 29,
    "archive_size": 22,
    "headline_family": "serif_bold",
    "supporting_family": "sans",
    "principle": "editorial_not_decorative"
  },
  "templates": {
    "editorial_photo_card": {
      "headline_priority": ["local_consequence", "verified_change"],
      "tone": "visual_newsroom"
    },
    "event_utility_card": {
      "headline_priority": ["what", "where"],
      "subline_priority": ["access", "time", "price"],
      "tone": "useful_immediate"
    },
    "investigation_card": {
      "headline_priority": ["amount", "public_interest_fact"],
      "subline_priority": ["actor_question", "what_is_being_built"],
      "tone": "documented_public_interest"
    },
    "public_money_card": {
      "headline_priority": ["amount"],
      "subline_priority": ["decision", "actor"],
      "tone": "clear_accountability"
    },
    "breaking_card": {
      "headline_priority": ["verified_change"],
      "subline_priority": ["place", "time", "consequence"],
      "tone": "clear_not_alarmist"
    },
    "explainer_carousel": {
      "cover": "one_claim_or_question",
      "body": "one_fact_per_slide",
      "last_slide": "what_to_watch_or_source_context",
      "tone": "dense_but_mobile_readable"
    },
    "data_card": {
      "headline_priority": ["number", "meaning"],
      "tone": "evidence_led"
    },
    "quote_card": {
      "use_only_when_quote_is_newsworthy": true,
      "speaker_context_required": true,
      "tone": "restrained"
    }
  },
  "qa": {
    "one_dominant_message": true,
    "headline_word_target_max": 10,
    "archive_marker_required_when_contextual": true,
    "brand_mark_required": true,
    "minimum_contrast_ratio_target": 4.5,
    "text_must_not_cover_primary_subject": true,
    "naked_photo_default_forbidden": true,
    "verbatim_facebook_reuse_forbidden": true,
    "mobile_first_legibility_required": true,
    "profile_and_post_identity_must_match": true,
    "shared_feed_signature_required": true,
    "decorative_badges_forbidden": true,
    "decorative_gradients_forbidden": true,
    "readability_gradient_must_be_functional_only": true,
    "debug_or_status_metadata_in_artwork_forbidden": true,
    "must_not_look_like_local_marketing_page": true,
    "must_not_look_ai_generated": true,
    "must_not_repeat_identical_layout_for_every_story": true
  }
}

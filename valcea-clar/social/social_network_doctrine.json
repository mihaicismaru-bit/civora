      "hook_policy": ["business_consequence", "investment_number", "public_funding", "institutional_change"],
      "native_product_families": ["professional_update", "document_explainer", "carousel"],
      "visual_strategy": "professional evidence-led visuals; charts or documents when more informative than photos",
      "final_copy_cross_platform_reuse": false,
      "benchmark": {
        "research_date": "2026-08-16",
        "outlets": ["The Wall Street Journal", "Bloomberg", "Reuters", "Associated Press"],
        "official_platform_guidance_reviewed": true,
        "platform_owner": "Microsoft"
      }

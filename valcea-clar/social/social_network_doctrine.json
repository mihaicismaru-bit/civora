    "telegram": {
      "channel_id": "valcea-telegram",
      "product_mode": "platform_native_message",
      "audience_role": "fast high-signal opt-in local updates",
      "interest_gate": "TELEGRAM_SIGNAL_GATE",
      "hook_policy": ["direct_update", "what_changed", "correction", "source_link"],
      "native_product_families": ["text_update", "correction", "compact_digest"],
      "visual_strategy": "text-first; media only when evidence or utility materially improves the update",

      "visual_strategy": "message-first; use compact media only when it increases utility",
      "final_copy_cross_platform_reuse": false,
      "benchmark": {
        "research_date": "2026-08-16",
        "outlets": ["The Washington Post", "CNN", "Associated Press"],
        "official_platform_guidance_reviewed": true,
        "platform_owner": "Meta"
      }

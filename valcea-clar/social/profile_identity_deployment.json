        "upload_file_method": "POST /{upload-id}",
        "apply_method": "POST /{phone-number-id}/whatsapp_business_profile",
        "readback_method": "GET /{phone-number-id}/whatsapp_business_profile?fields=profile_picture_url",
        "canonical_input_asset": "whatsapp-avatar.png",
        "upload_transform": "deterministic_jpeg",
        "upload_mime_type": "image/jpeg",
        "upload_token_type": "Meta User Access Token",
        "profile_token_type": "WhatsApp Business access token",
        "official_update_reference": "https://www.postman.com/meta/whatsapp-business-platform/request/mqqkbqj/update-business-profile",
        "official_upload_reference": "https://www.postman.com/meta/whatsapp-business-platform/request/13382743-871ea332-a6a4-4ad0-800a-0be9796b1933",
        "last_verified": "2026-08-16"
      },
      "runtime": {
        "enable_env": "VALCEA_WHATSAPP_PROFILE_LIVE_ENABLED",
        "access_token_env": "VALCEA_WHATSAPP_ACCESS_TOKEN",
        "upload_user_access_token_env": "VALCEA_META_USER_ACCESS_TOKEN",
        "phone_number_id_env": "VALCEA_WHATSAPP_PHONE_NUMBER_ID",
        "meta_app_id_env": "VALCEA_META_APP_ID",
        "graph_version_env": "VALCEA_WHATSAPP_GRAPH_VERSION"
      },
      "notes": "The official Business Profile picture flow is verified; VÂLCEA CLAR WhatsApp Business and Meta User Access Token credentials are not yet configured or confirmed."
    }
  },
  "quality_gate": {
    "all_identity_platforms_must_have_deployment_state": true,
    "all_ready_assets_must_be_generated_by_canonical_builder": true,
    "live_status_cannot_be_true_from_local_generation": true,
    "youtube_banner_apply_requires_explicit_enable_and_oauth": true,
    "youtube_banner_apply_requires_remote_readback": true,
    "telegram_photo_apply_requires_explicit_enable_and_bot_admin_access": true,
    "telegram_photo_apply_requires_remote_readback": true,
    "whatsapp_profile_apply_requires_explicit_enable_and_access": true,

      "api_capability_status": "OFFICIAL_BOT_API_SET_CHAT_PHOTO_VERIFIED",
      "live_status": "UNCONFIRMED",
      "profile_photo_api": {
        "apply_method": "setChatPhoto",
        "readback_method": "getChat",
        "transport": "multipart/form-data",
        "administrator_rights_required": true,
        "canonical_input_asset": "telegram-avatar.png",
        "official_reference": "https://core.telegram.org/bots/api#setchatphoto",
        "last_verified": "2026-08-16"
      },
      "runtime": {
        "enable_env": "VALCEA_TELEGRAM_PROFILE_LIVE_ENABLED",
        "bot_token_env": "VALCEA_TELEGRAM_BOT_TOKEN",
        "channel_id_env": "VALCEA_TELEGRAM_CHANNEL_ID"
      },
      "notes": "The official mutation path is verified; VÂLCEA CLAR bot/channel administrator access is not yet configured or confirmed."
    },
    "whatsapp": {
      "asset_status": "READY",
      "avatar_asset": "whatsapp-avatar.png",

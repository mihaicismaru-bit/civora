    },
    "instagram": {
      "asset_status": "READY",
      "avatar_asset": "instagram-avatar.png",
      "deployment_mode": "NOT_AUTOMATED",
      "api_capability_status": "PROFILE_MUTATION_PATH_NOT_VERIFIED",
      "live_status": "UNCONFIRMED"
    },
    "x": {
      "asset_status": "READY",
      "avatar_asset": "x-avatar.png",
      "header_asset": "x-header.jpg",
      "deployment_mode": "NOT_AUTOMATED",
      "api_capability_status": "PROFILE_MUTATION_ACCESS_NOT_CONFIGURED",
      "live_status": "UNCONFIRMED"
    },
    "threads": {
      "asset_status": "READY",
      "avatar_asset": "threads-avatar.png",

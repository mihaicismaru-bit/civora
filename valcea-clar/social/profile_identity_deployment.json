  "policy": {
    "asset_ready_does_not_mean_live": true,
    "never_claim_live_without_remote_ack_or_readback": true,
    "profile_mutation_must_be_separate_from_story_publication": true,
    "live_apply_requires_explicit_runtime_enable": true,
    "credential_values_must_never_be_persisted": true,
    "unsupported_or_unverified_mutation_paths_fail_closed": true
  },
  "platforms": {

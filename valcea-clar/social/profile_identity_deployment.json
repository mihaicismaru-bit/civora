      "api_capability_status": "PROFILE_MUTATION_ACCESS_NOT_CONFIGURED",
      "live_status": "UNCONFIRMED"
    },
    "youtube": {
      "asset_status": "READY",
      "avatar_asset": "youtube-avatar.png",
      "header_asset": "youtube-header.jpg",
      "deployment_mode": "API_GATED_BANNER_ONLY",
      "api_capability_status": "OFFICIAL_BANNER_API_VERIFIED",
      "live_status": "UNCONFIRMED",
      "banner_api": {
        "upload_method": "channelBanners.insert",
        "apply_method": "channels.update",
        "readback_method": "channels.list",
        "minimum_width": 2048,
        "minimum_height": 1152,
        "recommended_width": 2560,
        "recommended_height": 1440,
        "max_bytes": 6291456,
        "official_reference": "https://developers.google.com/youtube/v3/docs/channelBanners/insert",
        "official_channels_update_reference": "https://developers.google.com/youtube/v3/docs/channels/update",
        "last_verified": "2026-08-16"
      },
      "runtime": {
        "enable_env": "VALCEA_YOUTUBE_PROFILE_LIVE_ENABLED",
        "oauth_env": "VALCEA_YOUTUBE_OAUTH_ACCESS_TOKEN"
      },
      "notes": "Avatar deployment is not automated by this adapter; only the banner has a verified API mutation path."
    },
    "linkedin": {
      "asset_status": "READY",
      "avatar_asset": "linkedin-avatar.png",
      "header_asset": "linkedin-header.jpg",
      "deployment_mode": "NOT_AUTOMATED",

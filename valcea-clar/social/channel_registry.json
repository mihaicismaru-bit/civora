{
  "schema_version": 4,
  "instance_id": "valcea",
  "product": "CIVORA / VÂLCEA CLAR Social Publication Engine",
  "canonical_domain": "valceaclar.ro",
  "execution_owner": "civora_site_engine",
  "scheduler": "github_actions",
  "state_owner": "repository",
  "workflow": ".github/workflows/valcea-clar-social-publishing.yml",
  "publication_model": "continuous_story_first",
  "trigger_model": "story_publication_event_first_with_cron_recovery",
  "cadence": {
    "cron": "7,22,37,52 * * * *",
    "description": "15-minute recovery scan only; normal distribution is triggered immediately by a durable site story_publication_event"
  },
  "required_active_direct_channels": ["facebook", "instagram", "threads", "tiktok"],
  "chatgpt": {
    "scheduled_publication_allowed": false,
    "direct_publication_allowed": false,
    "credential_access_allowed": false,
    "state_ownership_allowed": false,
    "role": "operator_console_only"
  },
  "policy": {
    "verified_fact_kernel_required": true,
    "individual_story_is_distribution_unit": true,
    "edition_recap_is_distribution_gate": false,
    "site_story_may_publish_before_visual_channel_ready": true,
    "missing_story_specific_media_holds_only_affected_channel": true,
    "channel_native_copy_required": true,
    "cross_post_verbatim_forbidden": true,
    "approved_real_visual_required_when_visual_is_used": true,
    "synthetic_portrayal_of_real_people_forbidden": true,
    "generic_stock_substitution_forbidden": true,
    "idempotency_required": true,
    "deduplication_required": true,
    "correction_propagation_required": true,
    "paid_social_scheduler_required": false,
    "paid_llm_api_required": false,
    "local_runner_allowed": false,
    "self_hosted_runner_allowed": false,
    "fail_closed_on_missing_credentials": true,
    "fail_closed_on_missing_adapter": true,
    "legacy_items_without_platform_routing_are_facebook_only": true
  },
  "channels": [
    {
      "channel_id": "facebook",
      "status": "active",
      "direct_publication_enabled": true,
      "publication_mode": "native_api",
      "config": "valcea-clar/social/channels/facebook.json",
      "adapter": "valcea-clar/social/facebook_editorial_publish.py",
      "prepare": [
        "valcea-clar/social/build_live_story_outbox.py",
        "valcea-clar/social/fetch_approved_photos.py",
        "valcea-clar/social/editorial_asset_contract.py"
      ],
      "outbox": "valcea-clar/social/facebook_outbox.json",
      "state": "valcea-clar/social/facebook_state.json",
      "credentials": {
        "page_id_source": "workflow_configuration",
        "access_token_secret": "VALCEA_FB_PAGE_ACCESS_TOKEN"
      },
      "requirements": {
        "story_event": true,
        "canonical_story_readiness_gate": true,
        "facebook_interest_gate": true,
        "story_specific_real_photo_source": true,
        "editorial_composite": true,
        "source_photo_provenance": true,
        "source_photo_reuse_rights": true,
        "editor_approval": true,
        "canonical_story_link": true,
        "legacy_state_key_dedupe": true,
        "platform_native_copy": true
      }
    },
    {
      "channel_id": "instagram",
      "status": "active",
      "direct_publication_enabled": true,
      "publication_mode": "native_api",
      "config": "valcea-clar/social/channels/instagram.json",
      "adapter": "valcea-clar/social/instagram_editorial_publish.py",
      "prepare": [
        "valcea-clar/social/build_live_story_outbox.py",
        "valcea-clar/social/fetch_approved_photos.py",
        "valcea-clar/social/editorial_asset_contract.py"
      ],
      "outbox": "valcea-clar/social/facebook_outbox.json",
      "state": "valcea-clar/social/instagram_state.json",
      "credentials": {
        "account_id_variable": "VALCEA_IG_ACCOUNT_ID",
        "access_token_secret": "VALCEA_IG_ACCESS_TOKEN"
      },
      "requirements": {
        "story_event": true,
        "canonical_story_readiness_gate": true,
        "instagram_utility_gate": true,
        "professional_account": true,
        "content_publishing_permission": true,
        "public_jpeg": true,
        "story_specific_real_photo_source": true,
        "editorial_composite_cover": true,
        "editorial_text_cards_allowed": true,
        "public_media_preflight": true,
        "source_photo_provenance": true,
        "source_photo_reuse_rights": true,
        "editor_approval": true,
        "canonical_story_link": true,
        "legacy_state_key_dedupe": true,
        "platform_native_copy": true
      }
    },
    {
      "channel_id": "threads",
      "status": "active",
      "direct_publication_enabled": true,
      "publication_mode": "native_api_fail_closed",
      "workflow": ".github/workflows/valcea-clar-threads-editorial.yml",
      "config": "valcea-clar/social/channels/threads.json",
      "adapter": "valcea-clar/social/threads_publish.py",
      "prepare": [
        "valcea-clar/social/threads_editorial_v1.py",
        "valcea-clar/social/threads_editorial_materialize.py"
      ],
      "outbox": "valcea-clar/social/threads_outbox.json",
      "state": "valcea-clar/social/threads_state.json",
      "credentials": {
        "access_token_secret": "VALCEA_THREADS_ACCESS_TOKEN"
      },
      "requirements": {
        "story_event": true,
        "native_thread_sequence": true,
        "editor_approval": true,
        "source_preserving": true,
        "verified_publishing_access": true,
        "verified_username": "valceaclar",
        "activation_baseline_required": true,
        "historical_backlog_replay_forbidden": true,
        "partial_publish_manual_reconciliation": true,
        "platform_native_copy": true
      }
    },
    {
      "channel_id": "x",
      "status": "outbox_only",
      "direct_publication_enabled": false,
      "publication_mode": "durable_outbox_only",
      "config": "valcea-clar/social/channels/x.json",
      "adapter": null,
      "outbox": "valcea-clar/social/x_outbox.json",
      "state": "valcea-clar/social/x_state.json",
      "credentials": null,
      "requirements": {
        "story_event": true,
        "native_source_forward_thread": true,
        "fake_urgency_forbidden": true,
        "engagement_bait_forbidden": true,
        "editor_approval": true,
        "rights_metadata_when_visual_is_used": true,
        "zero_paid_dependency": true,
        "verified_publishing_access": false,
        "direct_publication_blocker": "x_api_pay_per_use_conflicts_zero_paid_dependency"
      }
    },
    {
      "channel_id": "linkedin",
      "status": "outbox_only",
      "direct_publication_enabled": false,
      "publication_mode": "durable_outbox_only",
      "config": "valcea-clar/social/channels/linkedin.json",
      "adapter": null,
      "outbox": "valcea-clar/social/linkedin_outbox.json",
      "state": "valcea-clar/social/linkedin_state.json",
      "credentials": null,
      "requirements": {

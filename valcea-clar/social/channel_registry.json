      "credentials": {
        "access_token_secret": "VALCEA_TIKTOK_ACCESS_TOKEN",
        "public_posting_approved_variable": "VALCEA_TIKTOK_PUBLIC_POSTING_APPROVED"
      },
      "requirements": {
        "story_event": true,
        "creator_info_before_publish": true,
        "privacy_from_current_creator_options": true,
        "verified_media_domain": "valceaclar.ro",
        "public_posting_app_audit": true,
        "explicit_site_admin_consent_per_post": true,
        "music_usage_confirmation_per_post": true,
        "explicit_interaction_choices_for_short": true,
        "real_photo_for_single_photo": true,
        "real_video_for_short": true,
        "editor_approval": true,

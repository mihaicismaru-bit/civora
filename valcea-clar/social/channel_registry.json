    {
      "channel_id": "youtube",
      "status": "outbox_only",
      "direct_publication_enabled": false,
      "publication_mode": "durable_outbox_only",
      "config": "valcea-clar/social/channels/youtube.json",
      "adapter": null,
      "outbox": "valcea-clar/social/youtube_outbox.json",
      "state": "valcea-clar/social/youtube_state.json",
      "credentials": null,
      "requirements": {
        "real_video_for_short": true,
        "editor_approval": true,
        "rights_metadata": true,
        "verified_upload_access": false
      }
    },
    {
      "channel_id": "tiktok",
      "status": "active",
      "direct_publication_enabled": true,
      "publication_mode": "native_api_gated_by_site_consent_and_app_audit",
      "config": "valcea-clar/social/channels/tiktok.json",
      "adapter": "valcea-clar/social/tiktok_publish.py",
      "prepare": [
        "valcea-clar/social/build_live_story_outbox.py",

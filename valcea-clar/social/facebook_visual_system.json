{
  "schema_version": "1.1",
  "channel_id": "valcea-facebook",
  "master_identity_system": "valcea-clar/social/social_brand_system.json",
  "profile_identity_system": "valcea-clar/social/profile_identity_system.json",
  "feed_renderer": "valcea-clar/social/feed_identity_v1_1.py",
  "canvas": {"width": 1200, "height": 1500, "aspect_ratio": "4:5"},
  "brand": {
    "name": "VÂLCEA CLAR",
    "editorial_lockup": "VÂLCEA. CLAR.",
    "accent_rgb": [196, 27, 35],
    "paper_rgb": [247, 246, 243],
    "ink_rgb": [20, 20, 20],
    "white_rgb": [255, 255, 255],
    "safe_margin_px": 76,
    "logo_presence": "quiet_consistent"
  },
  "profile_identity": {
    "avatar_strategy": "same_master_editorial_mark_as_instagram",
    "avatar_legible_at_px": 32,
    "cover_strategy": "editorial_masthead_not_advertising_banner",
    "cover_required_elements": [
      "VÂLCEA CLAR",
      "Ce se întâmplă. Ce știm. Ce contează.",
      "valceaclar.ro"
    ],
    "bio_strategy": "mission_first_plus_local_coverage_plus_canonical_site",
    "page_rule": "must_read_as_established_newsroom_before_user_opens_any_post"
  },
  "feed_visual_signature": {
    "composition": "contextual_photo_plus_spacious_paper_news_brief",
    "brand_mark": "VC.",
    "brand_mark_period": "typographic_red_same_baseline",
    "brand_mark_role": "quiet_newsroom_locator",
    "accent_rule": "short_horizontal_red_locator",
    "divider": "thin_editorial_hairline",
    "vertical_accent_bar": false,
    "section_label": "plain_uppercase_no_pill",
    "headline_family": "serif_bold",
    "supporting_family": "sans",
    "domain_treatment": "quiet",
    "negative_space": "deliberate",
    "decorative_badges": false,
    "decorative_gradients": false,
    "drop_shadows": false,
    "debug_or_status_metadata_in_artwork": false
  },
  "typography": {
    "hook_max_lines": 3,
    "hook_size_max": 68,
    "hook_size_min": 52,
    "subline_size": 32,
    "kicker_size": 24,
    "brand_size": 27,
    "headline_family": "serif_bold",
    "supporting_family": "sans",
    "principle": "editorial_not_promotional"
  },
  "templates": {
    "fb_news_card": "photo_plus_editorial_footer",
    "fb_public_money_card": "photo_plus_number_led_footer",
    "fb_investigation_card": "photo_plus_public_interest_footer",
    "fb_event_utility": "photo_plus_utility_footer",
    "fb_breaking_update": "verified_change_plus_place_or_consequence",
    "fb_explainer_carousel": "one_fact_per_frame_with_clear_cover"
  },
  "copy": {
    "lead_rule": "local_consequence_or_useful_fact_first",
    "context_rule": "add_only_context_that_helps_reader_understand_or_act",
    "link_rule": "canonical_story_link_when_article_exists",
    "tone": "confident_clear_not_tabloid"
  },
  "qa": {
    "one_dominant_visual_idea": true,
    "hook_word_target_max": 14,
    "archive_marker_required_when_contextual": true,
    "canonical_link_required": true,
    "facebook_copy_must_not_equal_instagram": true,
    "engagement_bait_forbidden": true,
    "fake_urgency_forbidden": true,
    "mobile_first_legibility_required": true,
    "profile_and_post_identity_must_match": true,
    "shared_feed_signature_required": true,
    "decorative_badges_forbidden": true,
    "decorative_gradients_forbidden": true,
    "vertical_accent_bar_forbidden": true,
    "debug_or_status_metadata_in_artwork_forbidden": true,
    "must_not_look_like_local_marketing_page": true,
    "must_not_look_ai_generated": true,
    "must_not_repeat_identical_layout_for_every_story": true
  }
}

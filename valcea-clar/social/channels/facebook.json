{
  "schema_version": "1.1",
  "channel_id": "valcea-facebook",
  "instance_id": "valcea",
  "platform": "facebook",
  "status": "active",
  "audience_promise": "Știri locale utile și explicate pentru oamenii din Vâlcea, cu context civic, evenimente și conversație comunitară fără zgomot sau senzaționalism.",
  "editorial_mix": {
    "priorities": [
      "service_journalism",
      "local_events",
      "civic_updates",
      "public_money",
      "infrastructure",
      "local_places",
      "sports_utility",
      "verified_breaking_updates"
    ],
    "exclusions": [
      "unverified_accusations",
      "rage_bait",
      "fake_urgency",
      "synthetic_real_person_imagery",
      "verbatim_cross_posting"
    ]
  },
  "native_formats": [
    "text",
    "single_photo",
    "editorial_card"
  ],
  "cadence": {
    "timezone": "Europe/Bucharest",
    "max_posts_per_day": 12,
    "min_spacing_minutes": 20,
    "quiet_hours": {
      "start": "23:00",
      "end": "06:30",
      "breaking_override": true
    }
  },
  "fatigue": {
    "same_story_cooldown_hours": 4,
    "max_related_posts_24h": 4
  },
  "media_policy": {
    "real_media_only": false,
    "allowed_families": [
      "FB_A_real_or_official_asset",
      "FB_B_editorial_card"
    ],
    "editorial_card_allowed": true,
    "editorial_card_site_reuse_forbidden": true,
    "provenance_required": true,
    "reuse_rights_required_for_third_party_media": true,
    "synthetic_real_person_forbidden": true,
    "invented_documentary_photo_forbidden": true
  },
  "link_policy": {
    "mode": "required",
    "canonical_hosts": [
      "valceaclar.ro",
      "www.valceaclar.ro"
    ]
  },
  "series": [
    {
      "series_id": "editia-de-dimineata",
      "promise": "Un sumar nativ cu lucrurile locale importante pentru începutul zilei."
    },
    {
      "series_id": "editia-de-seara",
      "promise": "Ce s-a schimbat și ce merită reținut la finalul zilei."
    },
    {
      "series_id": "unde-iesim",
      "promise": "Locuri, deschideri, meniuri și informații locale verificate."
    },
    {
      "series_id": "banii-publici",
      "promise": "Explicații clare despre cheltuieli, contracte și decizii publice documentate."
    }
  ],
  "approval_gates": {
    "low_risk_auto": true,
    "reputational_human": true,
    "corrections_priority": true
  },
  "credentials_ref": "github-actions-secret:VALCEA_FB_PAGE_ACCESS_TOKEN",
  "publication_state": {
    "outbox_path": "valcea-clar/social/facebook_outbox.json",
    "state_path": "valcea-clar/social/facebook_state.json",
    "dedupe_by_id": true,
    "last_known_good": true
  },
  "delivery_truth": {
    "delivered_requires_external_receipt_or_readback": true,
    "workflow_success_is_not_delivery": true
  },
  "metrics": {
    "observed_only": true,
    "sources": [
      "meta_graph_api"
    ]
  },
  "zero_paid_dependency": true
}

{
  "schema_version": "1.1",
  "channel_id": "valcea-threads",
  "instance_id": "valcea",
  "platform": "threads",
  "status": "active",
  "audience_promise": "Actualizări locale scurte, clare și verificabile pentru Vâlcea, cu context suficient în fir și conversație comunitară fără senzaționalism sau obligația de a da click.",
  "editorial_mix": {
    "priorities": [
      "service_journalism",
      "civic_updates",
      "infrastructure",
      "local_events",
      "public_money",
      "local_places",
      "verified_breaking_updates"
    ],
    "exclusions": [
      "unverified_accusations",
      "rage_bait",
      "fake_urgency",
      "fake_exclusivity",
      "engagement_bait",
      "synthetic_real_person_imagery",
      "verbatim_cross_posting"
    ]
  },
  "native_formats": [
    "thread",
    "text",
    "single_photo"
  ],
  "cadence": {
    "timezone": "Europe/Bucharest",
    "max_posts_per_day": 8,
    "min_spacing_minutes": 30,
    "quiet_hours": {
      "start": "23:00",
      "end": "06:30",
      "breaking_override": true
    }
  },
  "fatigue": {
    "same_story_cooldown_hours": 6,
    "max_related_posts_24h": 3
  },
  "media_policy": {
    "real_media_only": true,
    "provenance_required": true,
    "reuse_rights_required": true,
    "synthetic_real_person_forbidden": true
  },
  "link_policy": {
    "mode": "native_preferred",
    "canonical_hosts": [
      "valceaclar.ro",
      "www.valceaclar.ro"
    ]
  },
  "series": [
    {
      "series_id": "valcea-in-3-idei",
      "promise": "Trei idei locale utile, explicate compact într-un fir nativ."
    },
    {
      "series_id": "ce-se-schimba",
      "promise": "Schimbări locale concrete care merită urmărite și actualizate."
    }
  ],
  "approval_gates": {
    "low_risk_auto": true,
    "reputational_human": true,
    "corrections_priority": true
  },
  "credentials_ref": "github-actions-secret:VALCEA_THREADS_ACCESS_TOKEN",
  "publication_state": {
    "outbox_path": "valcea-clar/social/threads_outbox.json",
    "state_path": "valcea-clar/social/threads_state.json",
    "dedupe_by_id": true,
    "last_known_good": true,
    "activation_baseline_required": true,
    "partial_publish_requires_manual_reconciliation": true
  },
  "metrics": {
    "observed_only": true,
    "sources": [
      "threads_api"
    ]
  },
  "zero_paid_dependency": true
}

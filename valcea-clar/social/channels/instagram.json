{
  "schema_version": "1.1",
  "channel_id": "valcea-instagram",
  "instance_id": "valcea",
  "platform": "instagram",
  "status": "active",
  "audience_promise": "Vâlcea explicată vizual, prin fotografii reale, informații locale verificate și formate native ușor de urmărit și salvat.",
  "editorial_mix": {
    "priorities": [
      "local_events",
      "service_journalism",
      "local_places",
      "civic_updates",
      "infrastructure",
      "public_money",
      "verified_breaking_updates"
    ],
    "exclusions": [
      "unverified_accusations",
      "rage_bait",
      "fake_urgency",
      "synthetic_real_person_imagery",
      "verbatim_cross_posting"
    ]
  },
  "native_formats": [
    "single_photo",
    "carousel",
    "story",
    "reel",
    "editorial_fact_card",
    "data_card",
    "document_led"
  ],
  "cadence": {
    "timezone": "Europe/Bucharest",
    "max_posts_per_day": 8,
    "min_spacing_minutes": 30,
    "quiet_hours": {
      "start": "23:00",
      "end": "06:30",
      "breaking_override": true
    }
  },
  "fatigue": {
    "same_story_cooldown_hours": 6,
    "max_related_posts_24h": 3
  },
  "media_policy": {
    "real_media_only": false,
    "allowed_families": [
      "real_or_official_photo",
      "editorial_fact_card",
      "data_card",
      "document_led",
      "editorial_layout"
    ],
    "native_feed_ratio": "4:5",
    "story_or_reel_cover_ratio": "9:16",
    "provenance_required": true,
    "reuse_rights_required_for_third_party_media": true,
    "synthetic_real_person_forbidden": true,
    "invented_documentary_photo_forbidden": true,
    "generic_photo_only_to_fill_space_forbidden": true
  },
  "link_policy": {
    "mode": "optional",
    "canonical_hosts": [
      "valceaclar.ro",
      "www.valceaclar.ro"
    ]
  },
  "series": [
    {
      "series_id": "valcea-pe-scurt",
      "promise": "Un sumar vizual nativ al lucrurilor locale importante din ediția verificată."
    },
    {
      "series_id": "unde-iesim",
      "promise": "Locuri, deschideri și experiențe locale documentate cu fotografii reale."
    },
    {
      "series_id": "banii-publici",
      "promise": "Explicații vizuale despre proiecte, contracte și decizii publice."
    }
  ],
  "approval_gates": {
    "low_risk_auto": true,
    "reputational_human": true,
    "corrections_priority": true
  },
  "credentials_ref": "github-actions-secret:VALCEA_IG_ACCESS_TOKEN",
  "publication_state": {
    "outbox_path": "valcea-clar/social/facebook_outbox.json",
    "state_path": "valcea-clar/social/instagram_state.json",
    "dedupe_by_id": true,
    "last_known_good": true
  },
  "delivery_truth": {
    "delivered_requires_external_receipt_or_readback": true,
    "workflow_success_is_not_delivery": true
  },
  "metrics": {
    "observed_only": true,
    "sources": [
      "instagram_graph_api"
    ]
  },
  "zero_paid_dependency": true
}

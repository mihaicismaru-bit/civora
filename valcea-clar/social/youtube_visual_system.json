{
  "schema_version": "1.0",
  "channel_id": "valcea-youtube",
  "master_identity_system": "valcea-clar/social/social_brand_system.json",
  "profile_identity_system": "valcea-clar/social/profile_identity_system.json",
  "role": "searchable_video_news_archive_explainers_and_field_reporting",
  "canvas": {
    "short": {
      "width": 1080,
      "height": 1920,
      "aspect_ratio": "9:16"
    },
    "long_video": {
      "width": 1920,
      "height": 1080,
      "aspect_ratio": "16:9"
    },
    "thumbnail": {
      "width": 1280,
      "height": 720,
      "aspect_ratio": "16:9"
    }
  },
  "brand": {
    "name": "VÂLCEA CLAR",
    "editorial_lockup": "VÂLCEA. CLAR.",
    "accent_rgb": [196, 27, 35],
    "paper_rgb": [247, 246, 243],
    "ink_rgb": [20, 20, 20],
    "white_rgb": [255, 255, 255],
    "opening_bumper": "maximum_minimal_and_never_before_the_story_value",
    "brand_bug": "small_quiet_and_consistent"
  },
  "thumbnail_system": {
    "strategy": "one_story_specific_image_plus_one_editorial_message",
    "headline_word_target_max": 6,
    "logo_presence": "quiet",
    "subject_integrity_required": true,
    "fake_composite_forbidden": true,
    "misleading_expression_or_crop_forbidden": true,
    "sensational_arrows_circles_and_fake_reaction_graphics_forbidden": true,
    "visual_should_still_make_sense_without_logo": true
  },
  "formats": {
    "short": {
      "opening": "news_value_or_strongest_verified_visual",
      "structure": "fact_context_consequence",
      "end": "source_or_next_step_when_useful"
    },
    "explainer": {
      "opening": "question_or_consequence",
      "structure": "what_happened_why_it_matters_evidence_unknowns",
      "end": "what_to_watch"
    },
    "investigation_video": {
      "opening": "documented_public_interest_fact",
      "structure": "claim_evidence_response_unknowns",
      "end": "source_and_method_transparency"
    },
    "event_or_field_report": {
      "opening": "place_and_what_is_happening",
      "structure": "observed_visuals_verified_context_service_information",
      "end": "what_changes_next"
    }
  },
  "qa": {
    "thumbnail_must_match_video": true,
    "real_story_specific_media_required": true,
    "synthetic_real_person_or_place_portrayal_forbidden": true,
    "generic_stock_substitution_forbidden": true,
    "fake_urgency_forbidden": true,
    "engagement_bait_forbidden": true,
    "verbatim_cross_posting_forbidden": true,
    "must_not_look_like_local_marketing_page": true,
    "must_not_look_ai_generated": true,
    "must_not_repeat_identical_layout_for_every_story": true
  }
}

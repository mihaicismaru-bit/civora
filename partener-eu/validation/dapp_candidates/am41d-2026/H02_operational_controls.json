  "analysis_candidate": {
    "editorial_decision": "Not a generic migrant integration grant: this finances operational relocation support predeparture/transfer and 30 days postarrival for refugees in Kenya/Egypt, coordinated with IGI.",
    "decision_30s": "Apelul AM41D are 5 mil. lei alocare FEN, nu 5 mil. EUR; ghidul v2 permite mai multe categorii de solicitanți decât ONG-urile. Sunt cerute activități logistice și asistență directă cu IGI, plus praguri minime pe fiecare secțiune. Termen oficial 16 octombrie 2026, ora 16.00. Indicatorul de rezultat PN 400 nu se copiază automat drept obligație per proiect: rezultatul preconizat al apelului este 300.",
    "applicant_vs_target": "Solicitanți: categorii instituționale în G.1; entități externe doar cobeneficiari G.2. Grup țintă: refugiați ce necesită relocare din Kenya și/sau Egipt.",
    "budget_vs_grant": "5m lei is CALL FEN allocation. 6,666,666 lei is max total eligible cost/project, not call budget. 100% CFN consists of 75% FEN and 25% FNN, subject to eligible costs.",
    "eligible_actions": [
      "logistics for IGI selection missions, only upon IGI request",
      "medical checks and cultural orientation >=4 days",
      "safe transfer with interpretation / specialised needs",
      "30-day post-arrival support"
    ],
    "prohibited_or_risky": [
      "independent promotional/preparation actions",
      "calling 700 and 400 programme metrics mandatory per-project minima without model/indicator definitions",
      "assuming project amounts are EUR based on HTML",
      "assuming the 'TVA NU' field prohibits reimbursing any VAT"
    ],
    "three_actions": [
      "Check applicant and foreign partner classification under G.1–G.2; evidence financial/operational capacity and relevant overseas-resettlement experience, without assuming partnership is legally mandatory solely from wording.",
      "Map 300 expected relocated/supported project result vs PN output 700 and PN result 400; agree project-specific indicator targets with exact form and current programme methodology.",
      "Build direct assistance budget in RON and evidence package (payroll 12 months, activity methodology, no local tax debt), test ROFED, submit before 16 Oct 16:00 and preserve confirmation receipt."
    ]
  },

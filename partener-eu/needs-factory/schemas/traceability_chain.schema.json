{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf.traceability_chain.v0.1",
  "title": "Needs Factory Traceability Chain",
  "type": "object",
  "required": ["need_id", "evidence_ids", "intervention"],
  "properties": {
    "need_id": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "cause_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "intervention": {"type": "string", "minLength": 1},
    "output": {"type": ["string", "null"]},
    "result": {"type": ["string", "null"]},
    "indicator_id": {"type": ["string", "null"]},
    "target": {"type": ["number", "integer", "null"]},
    "constraint": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
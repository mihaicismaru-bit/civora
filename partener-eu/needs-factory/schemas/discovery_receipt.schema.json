{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf.discovery_receipt.v0.1",
  "title": "Needs Factory CIVORA Discovery Receipt",
  "type": "object",
  "required": ["candidate_id", "requirement_id", "source", "source_family", "final_url", "health", "semantic_sha256", "scope", "territory", "constructs", "facts"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_family": {"type": "string", "minLength": 1},
    "official": {"type": "boolean"},
    "tier": {"type": ["string", "null"]},
    "final_url": {"type": "string", "minLength": 1},
    "source_document_id": {"type": ["string", "null"]},
    "health": {"enum": ["PASS", "FAIL"]},
    "quarantined": {"type": "boolean"},
    "raw_sha256": {"type": ["string", "null"]},
    "semantic_sha256": {"type": "string", "minLength": 32},
    "scope": {"enum": ["school", "beneficiary", "uat", "locality", "county", "region", "national", "eu"]},
    "territory": {"type": "string", "minLength": 1},
    "population": {},
    "constructs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "direct_measurement": {"type": "boolean"},
    "publication_date": {"type": ["string", "null"]},
    "source_date": {"type": ["string", "null"]},
    "period": {"type": ["string", "null"]},
    "last_success": {"type": ["string", "null"]},
    "material_fact_state": {"type": ["string", "null"]},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["construct", "measures"],
        "properties": {
          "construct": {"type": "string"},
          "territory": {"type": ["string", "null"]},
          "scope": {"type": ["string", "null"]},
          "population": {},
          "period": {"type": ["string", "null"]},
          "measures": {"type": "array", "minItems": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
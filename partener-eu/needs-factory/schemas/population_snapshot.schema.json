{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf.population_snapshot.v0.1",
  "title": "Needs Factory Population Snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "as_of_date",
    "school_year",
    "school_identity",
    "eligible_population_n",
    "grades_in_scope",
    "qualifications_in_scope",
    "count_by_grade_and_qualification",
    "source_document_id",
    "source_date"
  ],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "school_year": {"type": "string", "minLength": 4},
    "school_identity": {"type": "string", "minLength": 1},
    "eligible_population_n": {"type": "integer", "minimum": 1},
    "grades_in_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "qualifications_in_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "count_by_grade_and_qualification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["grade", "qualification", "count"],
        "properties": {
          "grade": {"type": "string"},
          "qualification": {"type": "string"},
          "count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "source_document_id": {"type": "string", "minLength": 1},
    "source_date": {"type": "string"},
    "source_hash_or_receipt": {"type": ["string", "null"]},
    "historical_cutoff": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
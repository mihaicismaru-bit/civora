      "source_url": "https://www.regiocentru.ro/wp-content/uploads/2026/01/ANEXE-Studiu-evaluare-Tema-2.pdf",
      "tier": "A2",
      "territory": ["Sud-Vest Oltenia", "Sud-Muntenia", "Centru"],
      "scope": "NUTS2 regions",
      "period": "2023",
      "population": "employees in the Eurostat regional ICT business-statistics coverage",
      "constructs": ["business_digital_maturity", "digital_use_at_work"],
      "direct_measurement": true,
      "provenance": "Official ADR Centru evaluation, table sourced to Eurostat: Use of computers and the internet by employees, by NACE Rev.2 activity and NUTS 2 region",
      "measures": [
        {"name":"employees_using_internet_professionally_Sud_Vest_Oltenia","measure_type":"share","value":22.5,"unit":"percent"},
        {"name":"employees_using_internet_professionally_Sud_Muntenia","measure_type":"share","value":28.4,"unit":"percent"},
        {"name":"employees_using_internet_professionally_Centru","measure_type":"share","value":34.8,"unit":"percent"},
        {"name":"employees_using_internet_professionally_Romania","measure_type":"share","value":41.8,"unit":"percent"},
        {"name":"employees_using_internet_professionally_EU27","measure_type":"share","value":61.3,"unit":"percent"}
      ],
      "use": "Quantitative regional digital-use baseline for all three target regions. It is evidence of weak workplace digital use, not a direct AI-skill test and not a substitute for target-group measurement."
    },
    {
      "id": "EV-CENTRU-DIGITAL-NEEDS-SURVEY-2025",
      "source": "ADR Centru – Evaluarea intervențiilor Priorității 2 / online survey of applicants and beneficiaries",
      "source_url": "https://www.regiocentru.ro/wp-content/uploads/2026/01/ANEXE-Studiu-evaluare-Tema-2.pdf",
      "tier": "A2",
      "territory": "Centru",
      "scope": "region",
      "period": "August-September 2025",
      "population": "67 Priority 2 applicants/potential beneficiaries across all six counties; 31.3% SMEs, 17.9% microenterprises, remainder local authorities/partnerships",
      "constructs": ["employer_digital_skill_demand", "business_digital_maturity", "training_gap"],
      "direct_measurement": true,
      "measures": [
        {"name":"respondents_reporting_internal_digital_skills_lack_as_barrier","measure_type":"share","value":52.0,"unit":"percent","denominator_universe":"67 survey respondents"},
        {"name":"respondents_saying_calls_did_not_fully_cover_training_and_digital_skill_needs","measure_type":"share","value":36.0,"unit":"percent","denominator_universe":"67 survey respondents"},
        {"name":"respondents_saying_digital_maturity_eligibility_limited_early_stage_firms","measure_type":"share","value":28.0,"unit":"percent","denominator_universe":"67 survey respondents"}

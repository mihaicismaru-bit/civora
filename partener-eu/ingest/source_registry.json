{
  "schema_version": "1.8",
  "updated_utc": "2026-08-28",
  "policy": {
    "T1": "Authoritative official system or managing authority source. May support material facts when the exact source/evidence is captured and current.",
    "T1B": "Official delegated/subordinate/intermediate-body source. May support material facts within delegated scope when provenance is explicit; prefer T1 corroboration for conflicts.",
    "T2": "Official public-sector secondary source. Corroboration/discovery by default; do not override T1/T1B material facts.",
    "T3": "Discovery-only source such as search indexes or non-authoritative aggregators. Never authoritative for material facts.",
    "material_fact_change_rule": "A semantic/hash change never auto-updates deadline, eligibility, budget, scoring, beneficiaries or other material facts. Create or maintain a resolution task until authoritative evidence is re-established.",
    "conflict_rule": "T1 > T1B > T2 > T3. A lower-tier source may raise a conflict but never silently overwrite a higher-tier material fact.",
    "origin_rule": "Official attachments linked by a verified T1/T1B page retain the page provenance chain and are hashed independently.",
    "republication_rule": "An official OI/ADR republication of a MIPE document preserves discovery and corroboration value, but conflicts with an available T1 MIPE/MySMIS source must resolve in favor of current T1 evidence.",
    "programming_pipeline_rule": "PROGRAMMING_PIPELINE, PROPOSAL, CONSULTATION and PLANNED observations are non-authorizing. They must never become OPEN_CALL or authorize a material deadline, budget, eligibility or call status without a current official call/topic identifier and authoritative call endpoint.",
    "direct_funding_gateway_rule": "Official programme gateways, call indexes, programme guides and work-programme pages may support discovery and planning, but material call facts require the exact current call/topic/action evidence. Use the programme-specific dedicated adapter or structured Funding & Tenders adapter declared by the source; never treat a generic programme page, call index, guide or portal shell as call evidence."
  },
